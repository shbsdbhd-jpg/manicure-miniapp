# Auto detect text files and perform LF normalization
* text=auto

# Python files - use LF (Unix style)
*.py text eol=lf

# JavaScript/TypeScript files - use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# JSON files - use LF
*.json text eol=lf

# CSS files - use LF
*.css text eol=lf

# Markdown files - use LF
*.md text eol=lf

# Config files - use LF
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Shell scripts - use LF
*.sh text eol=lf

# Windows batch files - use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary

